{
  // --- Editor Appearance & Behavior ---
  "editor.fontSize": 14,
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.wordWrap": "on",
  "editor.minimap.enabled": true,
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorStyle": "line",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // --- Workbench & UI ---
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 16,
  "workbench.sideBar.location": "left",

  // --- Telemetry & Privacy (VSCodium specific perks) ---
  "telemetry.telemetryLevel": "off",

  // --- Font sizes (unified, editor.fontSize set above) ---
  "terminal.integrated.fontSize": 14,
  "debug.console.fontSize": 14,
  "markdown.preview.fontSize": 14,
  "chat.editor.fontSize": 14,
  "scm.inputFontSize": 14,

  // --- Workbench chrome font (applied via Custom CSS extension) ---
  // Path is machine-agnostic; install.sh symlinks custom.css into the User dir.
  "vscode_custom_css.imports": [
    "file://${userHome}/Library/Application Support/VSCodium/custom.css"
  ],

  // --- Search & Explorer ---
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true
  },

  // --- Git ---
  "git.autofetch": true,

  // --- TypeScript Specific Settings ---
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.unusedImports": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.unusedImports": "explicit"
    }
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",

  // --- Go Specific Settings ---
  "[go]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.rulers": [100]
  },
  "gopls": {
    "ui.semanticTokens": true,
    "ui.completion.usePlaceholders": true
  },
  "go.formatTool": "goimports",
  "go.useLanguageServer": true
}
